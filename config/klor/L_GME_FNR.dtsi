/**
 * Gaming Number Layer
 */

/* ZMK_BASE_LAYER(Gme_fnr, */
/* // ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮ */
/*     _X_             &kp F10         &kp F1          ___             &kp F2          &kp F3         ,    &kp F12         &kp F7          &kp F8          &kp F9          _X_             _X_            , */
/* // ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤ */
/*     _X_             &kp F4          ___             ___             ___             &kp F5         ,    &kp F11         &kp F4          &kp F5          &kp F6          _X_             _X_            , */
/* // ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤ */
/*     _X_             &kp F6          &kp F7          _X_             &kp F8          &kp F9         ,    &kp F10         &kp F1          &kp F2          &kp F3          _X_             _X_            , */
/* // ╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────├───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯ */
/*                                                     _X_             _X_             _X_            ,    _X_             &kp LSHFT       _X_  */
/* //                                                 ╰───────────────┴───────────────┴───────────────╯   ╰───────────────┴───────────────┴───────────────╯ */
/* ) */

// ┌───────────────────────────────────────────────────────────┐
label= "GME-FNR"                                               ;
// └───────────────────────────────────────────────────────────┘
 bindings = <
//                 ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
                    &kp F10         &kp F1          ___             &kp F2          &kp F3                                              _X_             &kp F7          &kp F8          &kp F9          _X_
// ╭───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤                                   ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┼───────────────╮
    _X_             &kp F4          ___             ___             ___             &kp F5                                              &kp F10         &kp F4          &kp F5          &kp F6          &kp F10         _X_        
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────╮   ╭───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
    _X_             &kp F6          &kp F7          _X_             &kp F8          &kp F9          &kp C_MUTE          &kp HOME        _X_             &kp F1          &kp F2          &kp F3          _X_             _X_
// ╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
                                                    _X_             _X_             _X_             _X_                 _X_             &kp LSHFT       _X_             _X_
//                                                 ╰───────────────┴───────────────┴───────────────┴───────────────╯   ╰───────────────┴───────────────┴───────────────┴───────────────╯
                        >;
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };

