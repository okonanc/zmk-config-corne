/**
 *  SYS Layer
 */

/* ZMK_BASE_LAYER(Sys, */
/* // ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮ */
/*     &out OUT_TOG    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4   ,    &bt BT_CLR      ___             ___             ___             ___             &kp C_POWER    , */
/* // ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤ */
/*     &ext_power EP_TOG ___           ___             &bt BT_PRV      &bt BT_NXT      &bootloader    ,    &bootloader     ___             ___             ___             ___             &kp C_RESET    , */
/* // ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤ */
/*     ___             ___             ___             ___             ___             &sys_reset     ,    &sys_reset      ___             ___             ___             ___             &kp C_AL_LOGOFF, */
/* // ╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────├───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯ */
/*                                                     ___             ___             CANCEL         ,    ___             ___             ___  */
/* //                                                 ╰───────────────┴───────────────┴───────────────╯   ╰───────────────┴───────────────┴───────────────╯ */
/* ) */

ZMK_BASE_LAYER(Sys,
//                 ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
                    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4   ,                                    &bt BT_CLR      ___             ___             ___             &kp C_POWER    ,
// ╭───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤                                   ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┼───────────────╮
    &out OUT_TOG    ___             ___             &bt BT_PRV      &bt BT_NXT      &bootloader    ,                                    &bootloader     ___             ___             ___             ___             &bt BT_CLR     ,
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────╮   ╭───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
    ___             ___             ___             ___             ___             &sys_reset      &kp C_MUTE     ,    &kp HOME        &sys_reset      ___             ___             ___             &kp C_AL_LOGOFF ---            , 
// ╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
                                                    ___             ___             CANCEL          ___            ,    ___             ___             ___             ___            ,
//                                                 ╰───────────────┴───────────────┴───────────────┴───────────────╯   ╰───────────────┴───────────────┴───────────────┴───────────────╯
&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN
)
