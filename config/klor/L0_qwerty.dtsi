/**
 * Alpha Layer - QWERTY
 */

#define HMR_ALT_DOT &hmr_alt_dot RALT 0

ZMK_BASE_LAYER(Qwerty,
//                 ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
                    &kp Q           &kp W           &kp E           &kp R           &kp T          ,                                    &kp Y           &kp U           &kp I           &kp O           &kp SQT        ,
// ╭───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤                                   ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┼───────────────╮
    &bs_del         &hml LCMD A     &hml LALT S     &hml LCTRL D    &hml LSHFT F    &hml MEH G     ,                                    &hmr MEH H      &hmr RSHFT J    &hmr LCTRL K    &hmr LALT L     &hmr LCMD P     &kp SQT        ,
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────╮   ╭───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
    &kp ESC         &kp Z           &kp X           &kp C           &kp V           &kp B           &kp C_MUTE     ,    &kp HOME        &kp N           &kp M           &comma_morph    HMR_ALT_DOT    &slash_morph    &kp BSLH       ,
// ╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
                                                    &lt SYS TAB     &lt_spc FNR 0   &kp RET         &mo NUM        ,    &mo SYS         SMART_NUM       MAGIC_SHIFT     &bs_del        ,
//                                                 ╰───────────────┴───────────────┴───────────────┴───────────────╯   ╰───────────────┴───────────────┴───────────────┴───────────────╯
&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN
)
